{
  "name": "retro-vscode",
  "displayName": "retro-vscode",
  "description": "A suite of tools for developing on the SNES with support for the SuperFX chip.",
  "version": "0.0.2",
  "publisher": "secondsun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/secondsun/retro-lsp"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:retroca65"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "retroca65",
        "filenames": [
          "Makefile"
        ],
        "configuration": "./language-configuration.json",
        "extensions": [
          ".sgs",
          ".s",
          ".i",
          ".inc"
        ]
      }
    ],
    "grammars": [
      {
        "language": "retroca65",
        "scopeName": "source.retroca65",
        "path": "./syntaxes/snes.json"
      }
    ],
    "configuration": {
      "title": "retroca65 configuration",
      "properties": {
        "retroca65.serverPath": {
          "scope": "machine-overridable",
          "type": "string",
          "default": "",
          "description": "Path to the retro-lsp launcher executable or script. If not set, defaults to project dist directory."
        },
        "retroca65.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VSCode and the language server."
        },
        "retroca65.libSFXRoot": {
          "scope": "window",
          "type": "string",
          "default": "../libSFX/include",
          "description": "The root of the libSFX includes directory relative to this window."
        },
        "retroca65.sourceDirectory": {
          "scope": "window",
          "type": "string",
          "default": ".",
          "description": "The root of the source directory relative to this window."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.0",
    "@types/vscode": "^1.91.0",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "eslint": "^8.57.1",
    "glob": "^11.0.1",
    "mocha": "^10.8.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  }
}
